<header class="header">
    <nav class="navbar" aria-label="Site">
        <div class="navbar-brand">
            <a class="navbar-item" href="{{{or site.url siteRootPath}}}">
                <img class="navbar-logo" src="{{{uiRootPath}}}/img/zimbra-logo.png" alt="Zimbra" width="145" height="33">
                <span class="navbar-title">{{site.title}}</span>
            </a>
            {{#if env.SITE_SEARCH_PROVIDER}}
                <div class="navbar-item search hide-for-print">
                    <div id="search-field" class="field">
                        <input id="search-input" type="text" aria-label="Search the docs" placeholder="Search the docs"{{#if page.home}} autofocus{{/if}}>
                    </div>
                </div>
            {{/if}}
        </div>
        <div id="topbar-nav" class="navbar-menu">
            <div class="navbar-end">
                <!-- Links are in the footer, which shows at every width -->
            </div>
        </div>
        <button id="theme-toggle" class="theme-toggle hide-for-print" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
            <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
    </nav>
</header>
